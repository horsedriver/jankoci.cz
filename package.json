{
  "name": "jankoci-portfolio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-cv.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/prepare-cv.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check": "npm run check:sensitive && npm run check:astro && npm run build && npm run check:localization && npm run check:links"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.1.6",
    "typescript": "^6.0.3"
  }
}
