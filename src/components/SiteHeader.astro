---
const currentPath = Astro.url.pathname;
const links = [
  { href: "/work/", label: "Work", cs: "Projekty" },
  { href: "/about/", label: "About", cs: "O mně" },
  { href: "/lab/", label: "Lab", cs: "Laboratoř" },
  { href: "/contact/", label: "Contact", cs: "Kontakt" }
];
---

<header class="site-header">
  <a class="identity" href="/" aria-label="Jan Kočí — home" data-aria-en="Jan Kočí — home" data-aria-cs="Jan Kočí — domů">
    <span class="identity-mark" aria-hidden="true">JK</span>
    <span>Jan Kočí</span>
  </a>
  <nav aria-label="Primary navigation" data-aria-en="Primary navigation" data-aria-cs="Hlavní navigace">
    {
      links.map(({ href, label, cs }) => (
        <a href={href} aria-current={currentPath.startsWith(href) ? "page" : undefined}>
          <span data-lang="en">{label}</span><span data-lang="cs">{cs}</span>
        </a>
      ))
    }
    <button class="nav-button" type="button" data-cv-open>CV</button>
    <div class="language-switch" role="group" aria-label="Language / Jazyk">
      <button type="button" data-set-lang="cs" aria-pressed="false">CZ</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
    </div>
  </nav>
</header>
