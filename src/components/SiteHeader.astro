---
const currentPath = Astro.url.pathname;
const englishPath = currentPath.startsWith("/cs/") ? currentPath.slice(3) || "/" : currentPath;
const czechPath = `/cs${englishPath === "/" ? "/" : englishPath}`;
const links = [
  { href: "/work/", label: "Work", cs: "Projekty" },
  { href: "/about/", label: "About", cs: "O mně" },
  { href: "/lab/", label: "Lab", cs: "Laboratoř" },
  { href: "/contact/", label: "Contact", cs: "Kontakt" }
];
---

<header class="site-header">
  <a class="identity" href="/" aria-label="Jan Kočí — home" data-aria-en="Jan Kočí — home" data-aria-cs="Jan Kočí — domů">
    <span class="identity-mark" aria-hidden="true">JK</span>
    <span>Jan Kočí</span>
  </a>
  <nav aria-label="Primary navigation" data-aria-en="Primary navigation" data-aria-cs="Hlavní navigace">
    {
      links.map(({ href, label, cs }) => (
        <a href={href} aria-current={englishPath.startsWith(href) ? "page" : undefined}>
          <span data-lang="en">{label}</span><span data-lang="cs">{cs}</span>
        </a>
      ))
    }
    <a class="nav-button" href="/cv/" data-cv-open>CV</a>
    <div class="language-switch" aria-label="Language / Jazyk">
      <a href={czechPath} data-language-link="cs" hreflang="cs" lang="cs">CZ</a>
      <span aria-hidden="true">/</span>
      <a href={englishPath} data-language-link="en" hreflang="en" lang="en" aria-current="page">EN</a>
    </div>
  </nav>
</header>
