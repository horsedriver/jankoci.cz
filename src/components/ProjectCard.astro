---
import type { CollectionEntry } from "astro:content";
import StatusPill from "./StatusPill.astro";

interface Props {
  entry: CollectionEntry<"work">;
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { data } = entry;
---

<article class="project-card">
  <div class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
  <div class="project-card-body">
    <div class="project-meta">
      <span>{data.eyebrow}</span>
      <StatusPill status={data.status} />
    </div>
    <h3><a href={`/work/${entry.id}/`}>{data.title}</a></h3>
    <p>{data.summary}</p>
    <ul class="outcome-list" aria-label="Selected outcomes">
      {data.outcomes.slice(0, 2).map((outcome) => <li>{outcome}</li>)}
    </ul>
    <a class="text-link" href={`/work/${entry.id}/`}>
      Read the case study <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
