---
import type { CollectionEntry } from "astro:content";
import StatusPill from "./StatusPill.astro";

interface Props {
  entry: CollectionEntry<"work">;
  entryCs: CollectionEntry<"workCs">;
  index?: number;
  headingLevel?: 2 | 3;
}

const { entry, entryCs, index = 0, headingLevel = 3 } = Astro.props;
const { data } = entry;
const dataCs = entryCs.data;
---

<article class="project-card">
  <div class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
  <div class="project-card-body">
    <div class="project-meta">
      <span><span data-lang="en">{data.eyebrow}</span><span data-lang="cs">{dataCs.eyebrow}</span></span>
      <StatusPill status={data.status} statusCs={dataCs.status} />
    </div>
    {headingLevel === 2 ? (
      <h2>
        <a href={`/work/${entry.id}/`}>
          <span data-lang="en">{data.title}</span><span data-lang="cs">{dataCs.title}</span>
        </a>
      </h2>
    ) : (
      <h3>
        <a href={`/work/${entry.id}/`}>
          <span data-lang="en">{data.title}</span><span data-lang="cs">{dataCs.title}</span>
        </a>
      </h3>
    )}
    <p><span data-lang="en">{data.summary}</span><span data-lang="cs">{dataCs.summary}</span></p>
    <ul class="outcome-list" aria-label="Vybrané výsledky / Selected outcomes">
      {data.outcomes.slice(0, 2).map((outcome, index) => (
        <li><span data-lang="en">{outcome}</span><span data-lang="cs">{dataCs.outcomes[index]}</span></li>
      ))}
    </ul>
    <a class="text-link" href={`/work/${entry.id}/`}>
      <span data-lang="en">Read the case study</span><span data-lang="cs">Přečíst případovou studii</span> <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
