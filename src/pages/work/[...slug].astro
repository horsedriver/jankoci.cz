---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusPill from "../../components/StatusPill.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  const localizedEntries = new Map((await getCollection("workCs")).map((entry) => [entry.id, entry]));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, entryCs: localizedEntries.get(entry.id) }
  }));
}

const { entry, entryCs } = Astro.props;
if (!entryCs) throw new Error(`Missing Czech case study: ${entry.id}`);
const { Content } = await render(entry);
const { Content: ContentCs } = await render(entryCs);
const { data } = entry;
const dataCs = entryCs.data;
---

<BaseLayout
  title={data.title}
  titleCs={dataCs.title}
  description={data.summary}
  descriptionCs={dataCs.summary}
  eyebrow={`${data.eyebrow} · ${data.status}`}
  eyebrowCs={`${dataCs.eyebrow} · ${dataCs.status}`}
>
  <article class="case-study">
    <header class="case-hero section-pad">
      <div class="case-meta">
        <span><span data-lang="en">{data.eyebrow}</span><span data-lang="cs">{dataCs.eyebrow}</span></span>
        <StatusPill status={data.status} statusCs={dataCs.status} />
      </div>
      <h1><span data-lang="en">{data.title}</span><span data-lang="cs">{dataCs.title}</span></h1>
      <p class="case-summary"><span data-lang="en">{data.summary}</span><span data-lang="cs">{dataCs.summary}</span></p>
      <dl class="case-facts">
        <div><dt><span data-lang="en">Period</span><span data-lang="cs">Období</span></dt><dd><span data-lang="en">{data.period}</span><span data-lang="cs">{dataCs.period}</span></dd></div>
        <div><dt><span data-lang="en">Role</span><span data-lang="cs">Role</span></dt><dd><span data-lang="en">{data.role}</span><span data-lang="cs">{dataCs.role}</span></dd></div>
        <div><dt><span data-lang="en">Evidence</span><span data-lang="cs">Důkazy</span></dt><dd><span data-lang="en">{data.evidence}</span><span data-lang="cs">{dataCs.evidence}</span></dd></div>
        <div><dt><span data-lang="en">Visibility</span><span data-lang="cs">Viditelnost</span></dt><dd><span data-lang="en">{data.visibility}</span><span data-lang="cs">{dataCs.visibility}</span></dd></div>
      </dl>
    </header>

    <section class="case-outcomes section-pad" aria-labelledby="outcomes-title">
      <div>
        <p class="section-label"><span data-lang="en">Selected outcomes</span><span data-lang="cs">Vybrané výsledky</span></p>
        <h2 id="outcomes-title"><span data-lang="en">What changed</span><span data-lang="cs">Co se změnilo</span></h2>
      </div>
      <ol>
        {data.outcomes.map((outcome, index) => <li><span data-lang="en">{outcome}</span><span data-lang="cs">{dataCs.outcomes[index]}</span></li>)}
      </ol>
    </section>

    <div class="case-body section-pad">
      <aside>
        <p class="section-label"><span data-lang="en">Capabilities</span><span data-lang="cs">Kompetence</span></p>
        <ul>{data.capabilities.map((capability, index) => <li><span data-lang="en">{capability}</span><span data-lang="cs">{dataCs.capabilities[index]}</span></li>)}</ul>
        {data.externalUrl && <a class="text-link" href={data.externalUrl}><span data-lang="en">View public evidence</span><span data-lang="cs">Zobrazit veřejné důkazy</span> ↗</a>}
      </aside>
      <div class="prose">
        <div class="localized-block" data-lang="en"><Content /></div>
        <div class="localized-block" data-lang="cs"><ContentCs /></div>
      </div>
    </div>

    <nav class="case-nav section-pad" aria-label="Navigace případové studie / Case study navigation">
      <a class="text-link" href="/work/">← <span data-lang="en">All work</span><span data-lang="cs">Všechny projekty</span></a>
      <a class="button secondary" href="/contact/"><span data-lang="en">Discuss a related problem</span><span data-lang="cs">Probrat podobný problém</span></a>
    </nav>
  </article>
</BaseLayout>
