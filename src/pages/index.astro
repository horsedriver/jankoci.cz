---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/home.css";

const featured = (await getCollection("work", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const localizedEntries = new Map((await getCollection("workCs")).map((entry) => [entry.id, entry]));
const featuredProjects = featured.map((entry) => {
  const entryCs = localizedEntries.get(entry.id);
  if (!entryCs) throw new Error(`Missing Czech case study: ${entry.id}`);
  return { entry, entryCs };
});

const stages = [
  { key: "reality", title: "Reality", titleCs: "Realita", text: "Raw signals and operational facts.", textCs: "Surové signály a provozní fakta." },
  { key: "evidence", title: "Evidence", titleCs: "Důkazy", text: "Structured context with provenance.", textCs: "Strukturovaný kontext s doložitelným původem." },
  { key: "decision", title: "Decision", titleCs: "Rozhodnutí", text: "Reasoned choices with explicit risk.", textCs: "Odůvodněná rozhodnutí s viditelným rizikem." },
  { key: "control", title: "Control", titleCs: "Kontrola", text: "Human-approved action and accountability.", textCs: "Lidsky schválené kroky a odpovědnost." }
];
---

<BaseLayout
  title="Jan Kočí — Systems Architect"
  titleCs="Jan Kočí — systémový architekt"
  description="Senior systems architect stabilizing Linux infrastructure, connecting fragmented systems and automating operations without losing control."
  descriptionCs="Seniorní systémový architekt, který stabilizuje linuxovou infrastrukturu, propojuje roztříštěné systémy a automatizuje provoz bez ztráty kontroly."
>
  <section class="personal-hero section-pad" aria-labelledby="home-title">
    <div class="personal-hero-copy">
      <p class="section-label"><span data-lang="en">Systems Architect · Technical Lead</span><span data-lang="cs">Systémový architekt · technický lead</span></p>
      <h1 id="home-title">
        <span data-lang="en">I stabilize complex infrastructure and turn chaos into controlled operations<span class="green-stop">.</span></span>
        <span data-lang="cs">Stabilizuji složitou infrastrukturu a měním chaos v řízený provoz<span class="green-stop">.</span></span>
      </h1>
      <p class="personal-hero-intro">
        <span data-lang="en">Linux, networks, telephony, automation and AI integration — from forensic diagnosis to production delivery and technical leadership.</span>
        <span data-lang="cs">Linux, sítě, telefonie, automatizace a integrace AI — od forenzní diagnostiky přes produkční nasazení až po technické vedení.</span>
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/work/"><span data-lang="en">View selected work</span><span data-lang="cs">Prohlédnout projekty</span> <span aria-hidden="true">→</span></a>
        <a class="button secondary" href="/cv/" data-cv-open><span data-lang="en">Preview CV</span><span data-lang="cs">Zobrazit CV</span></a>
        <a class="text-link hero-contact" href="/contact/"><span data-lang="en">Contact me</span><span data-lang="cs">Kontaktovat mě</span> <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <dl class="hero-proof" aria-label="Professional profile" data-aria-en="Professional profile" data-aria-cs="Profesní profil">
      <div><dt><span data-lang="en">Experience</span><span data-lang="cs">Praxe</span></dt><dd>18+ <span data-lang="en">years</span><span data-lang="cs">let</span></dd></div>
      <div><dt><span data-lang="en">Core</span><span data-lang="cs">Jádro</span></dt><dd>Linux · infrastructure · networks</dd></div>
      <div><dt><span data-lang="en">Delivery</span><span data-lang="cs">Dodávka</span></dt><dd>Architecture · automation · leadership</dd></div>
      <div><dt><span data-lang="en">Base</span><span data-lang="cs">Lokalita</span></dt><dd><span data-lang="en">Prague · remote / hybrid</span><span data-lang="cs">Praha · remote / hybrid</span></dd></div>
    </dl>
  </section>

  <section class="recruiter-layer section-pad" aria-labelledby="recruiter-title">
    <div>
      <p class="section-label"><span data-lang="en">For recruiters and clients</span><span data-lang="cs">Pro recruitery a klienty</span></p>
      <h2 id="recruiter-title"><span data-lang="en">Architecture without theatre. Delivery without chaos.</span><span data-lang="cs">Architektura bez divadla. Realizace bez chaosu.</span></h2>
      <p class="recruiter-intro"><span data-lang="en">Best fit: infrastructure architecture, DevOps, systems integration, technical transformation and AI-assisted operations where ownership matters.</span><span data-lang="cs">Nejlépe zapadnu do infrastruktury, DevOps, systémových integrací, technické transformace a provozu podporovaného AI, kde záleží na skutečné odpovědnosti.</span></p>
    </div>
    <dl class="recruiter-facts">
      <div><dt><span data-lang="en">Availability</span><span data-lang="cs">Nástup</span></dt><dd><span data-lang="en">By agreement</span><span data-lang="cs">Dohodou</span></dd></div>
      <div><dt><span data-lang="en">Best fit</span><span data-lang="cs">Zaměření</span></dt><dd>Linux · architecture · automation · AI integration</dd></div>
      <div><dt><span data-lang="en">Work style</span><span data-lang="cs">Styl práce</span></dt><dd><span data-lang="en">Evidence, ownership, calm operations</span><span data-lang="cs">Důkazy, odpovědnost, klidný provoz</span></dd></div>
      <div><dt><span data-lang="en">Contact</span><span data-lang="cs">Kontakt</span></dt><dd><a class="text-link" href="mailto:jan@jankoci.cz">jan@jankoci.cz →</a></dd></div>
    </dl>
  </section>

  <section class="positioning section-pad" aria-labelledby="positioning-title">
    <div><p class="section-label"><span data-lang="en">What I solve</span><span data-lang="cs">Co řeším</span></p><h2 id="positioning-title"><span data-lang="en">Complexity becomes manageable once it becomes visible.</span><span data-lang="cs">Složitost lze řídit, jakmile se stane viditelnou.</span></h2></div>
    <div class="problem-list">
      <article><span>01</span><h3><span data-lang="en">Stabilize unreliable systems</span><span data-lang="cs">Stabilizovat nespolehlivé systémy</span></h3><p><span data-lang="en">Recover ownership, isolate failure modes and move from firefighting to controlled operations.</span><span data-lang="cs">Obnovit odpovědnost, izolovat způsoby selhání a přejít od hašení problémů k řízenému provozu.</span></p></article>
      <article><span>02</span><h3><span data-lang="en">Connect fragmented infrastructure</span><span data-lang="cs">Propojit roztříštěnou infrastrukturu</span></h3><p><span data-lang="en">Map dependencies across Linux, networks, telephony, cloud services and the people who run them.</span><span data-lang="cs">Zmapovat závislosti mezi Linuxem, sítěmi, telefonií, cloudem a lidmi, kteří systémy skutečně provozují.</span></p></article>
      <article><span>03</span><h3><span data-lang="en">Automate without losing control</span><span data-lang="cs">Automatizovat bez ztráty kontroly</span></h3><p><span data-lang="en">Use verification and human approval so automation reduces risk instead of producing faster mistakes.</span><span data-lang="cs">Použít ověřování a lidské schválení, aby automatizace snižovala riziko místo rychlejší výroby chyb.</span></p></article>
    </div>
  </section>

  <section class="cybercore-feature section-pad" aria-labelledby="cybercore-title">
    <div class="cybercore-copy">
      <p class="section-label"><span data-lang="en">Flagship project · CyberCore</span><span data-lang="cs">Vlajkový projekt · CyberCore</span></p>
      <h2 id="cybercore-title"><span data-lang="en">Infrastructure decisions backed by evidence.</span><span data-lang="cs">Rozhodování o infrastruktuře podložené důkazy.</span></h2>
      <p><span data-lang="en">CyberCore turns operational signals into verifiable decisions and controlled actions while humans retain final authority.</span><span data-lang="cs">CyberCore mění provozní signály na ověřitelná rozhodnutí a kontrolované kroky, přičemž konečná autorita zůstává lidem.</span></p>
      <div class="feature-actions">
        <a class="button primary" href="/work/cybercore/"><span data-lang="en">Read the case study</span><span data-lang="cs">Přečíst případovou studii</span> <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="https://github.com/cyberDJs/CyberCore"><span data-lang="en">Open repository</span><span data-lang="cs">Otevřít repozitář</span></a>
      </div>
    </div>
    <div class="cyber-flow" aria-label="CyberCore flow: Reality, Evidence, Decision, Control" data-aria-en="CyberCore flow: Reality, Evidence, Decision, Control" data-aria-cs="Tok CyberCore: Realita, Důkazy, Rozhodnutí, Kontrola">
      {stages.map((stage, index) => (
        <article class={`flow-card flow-${stage.key}`}>
          <span class="flow-index">0{index + 1}</span>
          <h3><span data-lang="en">{stage.title}</span><span data-lang="cs">{stage.titleCs}</span></h3>
          <p><span data-lang="en">{stage.text}</span><span data-lang="cs">{stage.textCs}</span></p>
        </article>
      ))}
    </div>
  </section>

  <section class="selected-work section-pad" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="section-label"><span data-lang="en">Selected work</span><span data-lang="cs">Vybrané projekty</span></p><h2 id="work-title"><span data-lang="en">Proof before promises.</span><span data-lang="cs">Důkazy před sliby.</span></h2></div><a class="text-link" href="/work/"><span data-lang="en">See all work</span><span data-lang="cs">Zobrazit všechny projekty</span> <span aria-hidden="true">→</span></a></div>
    <div class="project-list">{featuredProjects.map(({ entry, entryCs }, index) => <ProjectCard entry={entry} entryCs={entryCs} index={index} />)}</div>
  </section>

  <section class="contact-band section-pad">
    <div><p class="section-label"><span data-lang="en">Available for the right problem</span><span data-lang="cs">Připraven řešit správný problém</span></p><h2><span data-lang="en">Bring me the system nobody fully understands.</span><span data-lang="cs">Přineste mi systém, kterému nikdo úplně nerozumí.</span></h2><p><span data-lang="en">Describe what is failing, fragmented or blocking delivery. I will respond with a concrete first technical view.</span><span data-lang="cs">Popište, co selhává, je roztříštěné nebo blokuje dodávku. Ozvu se s konkrétním prvním technickým pohledem.</span></p></div>
    <a class="button primary" href="mailto:jan@jankoci.cz">jan@jankoci.cz</a>
  </section>
</BaseLayout>