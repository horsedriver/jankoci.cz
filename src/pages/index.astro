---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/home.css";

const featured = (await getCollection("work", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const localizedEntries = new Map((await getCollection("workCs")).map((entry) => [entry.id, entry]));
const featuredProjects = featured.map((entry) => {
  const entryCs = localizedEntries.get(entry.id);
  if (!entryCs) throw new Error(`Missing Czech case study: ${entry.id}`);
  return { entry, entryCs };
});

const stages = [
  { key: "reality", title: "Reality", titleCs: "Realita", text: "The world as it is. Raw signals and observations.", textCs: "Svět takový, jaký je. Surové signály a pozorování." },
  { key: "evidence", title: "Evidence", titleCs: "Důkazy", text: "Structured facts with provenance and context.", textCs: "Strukturovaná fakta s původem a kontextem." },
  { key: "decision", title: "Decision", titleCs: "Rozhodnutí", text: "Reasoned choices derived from verifiable evidence.", textCs: "Odůvodněná rozhodnutí odvozená z ověřitelných důkazů." },
  { key: "control", title: "Control", titleCs: "Kontrola", text: "Actions that shape systems and ensure accountability.", textCs: "Kroky, které mění systémy a zachovávají odpovědnost." }
];
---

<BaseLayout
  title="Jan Kočí"
  titleCs="Jan Kočí"
  description="Systems architect building evidence-driven infrastructure intelligence that remains governed by humans."
  descriptionCs="Systémový architekt budující správu infrastruktury založenou na důkazech a řízenou lidmi."
>
  <section class="cyber-home section-pad" aria-labelledby="cyber-home-title">
    <div class="cyber-home-copy">
      <p class="section-label"><span data-lang="en">Flagship project · CyberCore</span><span data-lang="cs">Vlajkový projekt · CyberCore</span></p>
      <h1 id="cyber-home-title">
        <span data-lang="en">Infrastructure intelligence,<br />governed by humans<span class="green-stop">.</span></span>
        <span data-lang="cs">Inteligentní správa infrastruktury,<br />řízená lidmi<span class="green-stop">.</span></span>
      </h1>
      <p class="cyber-home-intro">
        <span data-lang="en">CyberCore is an open architecture and reference implementation for evidence-driven infrastructure intelligence. Foundation v0.1 and the checkpoint runtime are delivered; the active milestone is a controlled post-merge state transition.</span>
        <span data-lang="cs">CyberCore je otevřená architektura a referenční implementace pro správu infrastruktury založenou na důkazech. Foundation v0.1 i checkpoint runtime jsou hotové; aktuálním milníkem je řízený přechod stavu po sloučení změn.</span>
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/work/cybercore/"><span data-lang="en">Explore the architecture</span><span data-lang="cs">Prozkoumat architekturu</span> <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="https://github.com/cyberDJs/CyberCore"><span data-lang="en">Open repository</span><span data-lang="cs">Otevřít repozitář</span> <span aria-hidden="true">↗</span></a>
      </div>
      <p class="cyber-now"><i aria-hidden="true"></i><strong><span data-lang="en">Now</span><span data-lang="cs">Nyní</span></strong><span>·</span><span><span data-lang="en">July 2026</span><span data-lang="cs">červenec 2026</span></span></p>
    </div>

    <div class="cyber-flow" aria-label="CyberCore flow: Reality, Evidence, Decision, Control" data-aria-en="CyberCore flow: Reality, Evidence, Decision, Control" data-aria-cs="Tok CyberCore: Realita, Důkazy, Rozhodnutí, Kontrola">
      <div class="cyber-flow-cards">
        {stages.map((stage, index) => (
          <>
            <article class={`flow-card flow-${stage.key}`}>
              <div class="flow-icon" aria-hidden="true">
                {stage.key === "reality" && <span class="reality-icon"><b></b>{Array.from({ length: 8 }).map(() => <i></i>)}</span>}
                {stage.key === "evidence" && <span class="evidence-icon">{Array.from({ length: 9 }).map(() => <i></i>)}</span>}
                {stage.key === "decision" && <span class="decision-icon"><i></i></span>}
                {stage.key === "control" && <span class="control-icon"><i></i><b></b></span>}
              </div>
              <h2><span data-lang="en">{stage.title}</span><span data-lang="cs">{stage.titleCs}</span></h2>
              <p><span data-lang="en">{stage.text}</span><span data-lang="cs">{stage.textCs}</span></p>
            </article>
            {index < stages.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
          </>
        ))}
      </div>
      <div class="flow-pipeline" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
      <div class="flow-signature"><strong>CYBERCORE</strong><span><span data-lang="en">Open architecture for infrastructure intelligence</span><span data-lang="cs">Otevřená architektura pro inteligentní správu infrastruktury</span></span></div>
    </div>
  </section>

  <section class="about-work section-pad" aria-labelledby="about-work-title">
    <div><p class="section-label"><span data-lang="en">About the work</span><span data-lang="cs">O projektu</span></p><h2 id="about-work-title"><span data-lang="en">Building a controlled future.</span><span data-lang="cs">Budování kontrolované budoucnosti.</span></h2></div>
    <p><span data-lang="en">I work at the intersection of systems engineering, data integrity and decision theory. CyberCore is my approach to infrastructure intelligence that is open, verifiable and safe by design.</span><span data-lang="cs">Pracuji na průsečíku systémového inženýrství, integrity dat a teorie rozhodování. CyberCore je můj přístup k inteligentní správě infrastruktury, která je otevřená, ověřitelná a bezpečná už ze svého návrhu.</span></p>
    <div class="about-work-visual" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  <section class="recruiter-layer section-pad" aria-labelledby="recruiter-title">
    <div><p class="section-label"><span data-lang="en">For recruiters</span><span data-lang="cs">Pro HR</span></p><h2 id="recruiter-title"><span data-lang="en">The human-readable version.</span><span data-lang="cs">Přehledně a bez lovení informací.</span></h2><p class="recruiter-intro"><span data-lang="en">I am looking for senior infrastructure, systems architecture, DevOps or AI integration work where ownership and practical judgement matter.</span><span data-lang="cs">Hledám seniorní roli v infrastruktuře, systémové architektuře, DevOps nebo AI integracích, kde záleží na odpovědnosti a praktickém úsudku.</span></p></div>
    <dl class="recruiter-facts">
      <div><dt><span data-lang="en">Base</span><span data-lang="cs">Lokalita</span></dt><dd><span data-lang="en">Prague · remote / hybrid</span><span data-lang="cs">Praha · vzdáleně / hybridně</span></dd></div>
      <div><dt><span data-lang="en">Availability</span><span data-lang="cs">Nástup</span></dt><dd><span data-lang="en">By agreement</span><span data-lang="cs">Dohodou</span></dd></div>
      <div><dt><span data-lang="en">Best fit</span><span data-lang="cs">Nejlepší zaměření</span></dt><dd><span data-lang="en">Linux · architecture · automation · AI integration</span><span data-lang="cs">Linux · architektura · automatizace · integrace AI</span></dd></div>
      <div><dt><span data-lang="en">Work style</span><span data-lang="cs">Styl práce</span></dt><dd><span data-lang="en">Evidence, ownership, calm operations</span><span data-lang="cs">Důkazy, odpovědnost, klidný provoz</span></dd></div>
      <div class="recruiter-actions"><dt>CV</dt><dd><a class="text-link" href="/cv/" data-cv-open><span data-lang="en">Preview CV →</span><span data-lang="cs">Náhled CV →</span></a></dd></div>
    </dl>
  </section>

  <section class="positioning section-pad" aria-labelledby="positioning-title">
    <div><p class="section-label"><span data-lang="en">What I solve</span><span data-lang="cs">Co řeším</span></p><h2 id="positioning-title"><span data-lang="en">Complexity is manageable once it becomes visible.</span><span data-lang="cs">Složitost lze řídit, jakmile se stane viditelnou.</span></h2></div>
    <div class="problem-list">
      <article><span>01</span><h3><span data-lang="en">Stabilize unreliable systems</span><span data-lang="cs">Stabilizovat nespolehlivé systémy</span></h3><p><span data-lang="en">Recover ownership, isolate failure modes and create a safe path from firefighting to controlled operations.</span><span data-lang="cs">Obnovit odpovědnost, izolovat způsoby selhání a vytvořit bezpečnou cestu od hašení problémů k řízenému provozu.</span></p></article>
      <article><span>02</span><h3><span data-lang="en">Connect fragmented infrastructure</span><span data-lang="cs">Propojit roztříštěnou infrastrukturu</span></h3><p><span data-lang="en">Map dependencies across Linux, networks, telephony, cloud services and the people who actually run them.</span><span data-lang="cs">Zmapovat závislosti mezi Linuxem, sítěmi, telefonií, cloudovými službami a lidmi, kteří je skutečně provozují.</span></p></article>
      <article><span>03</span><h3><span data-lang="en">Automate without losing control</span><span data-lang="cs">Automatizovat bez ztráty kontroly</span></h3><p><span data-lang="en">Use evidence, verification and human approval to make automation useful instead of merely enthusiastic.</span><span data-lang="cs">Využít důkazy, ověřování a lidské schválení, aby automatizace skutečně pomáhala a nejednala bezhlavě.</span></p></article>
    </div>
  </section>

  <section class="selected-work section-pad" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="section-label"><span data-lang="en">Selected work</span><span data-lang="cs">Vybrané projekty</span></p><h2 id="work-title"><span data-lang="en">Proof before promises.</span><span data-lang="cs">Důkazy před sliby.</span></h2></div><a class="text-link" href="/work/"><span data-lang="en">See all work</span><span data-lang="cs">Zobrazit všechny projekty</span> <span aria-hidden="true">→</span></a></div>
    <div class="project-list">{featuredProjects.map(({ entry, entryCs }, index) => <ProjectCard entry={entry} entryCs={entryCs} index={index} />)}</div>
  </section>

  <section class="contact-band section-pad"><div><p class="section-label"><span data-lang="en">Available for the right problem</span><span data-lang="cs">Připraven řešit správný problém</span></p><h2><span data-lang="en">Bring the system nobody fully understands.</span><span data-lang="cs">Přineste systém, kterému nikdo úplně nerozumí.</span></h2></div><a class="button primary" href="mailto:jan@jankoci.cz">jan@jankoci.cz</a></section>
</BaseLayout>
