---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  titleCs?: string;
  description: string;
  descriptionCs?: string;
  eyebrow?: string;
  eyebrowCs?: string;
}

const {
  title,
  description,
  titleCs = title,
  descriptionCs = description,
  eyebrow = "Systems Architect · Infrastructure · Telephony · AI Integration",
  eyebrowCs = "Systémový architekt · Infrastruktura · Telefonie · Integrace AI"
} = Astro.props;

const englishPath = Astro.url.pathname;
const czechPath = `/cs${englishPath === "/" ? "/" : englishPath}`;
const canonical = new URL(englishPath, Astro.site);
const alternateCs = new URL(czechPath, Astro.site);
const socialImage = new URL("/og-card.svg", Astro.site);
const fullTitle = title === "Jan Kočí" ? title : `${title} — Jan Kočí`;
const fullTitleCs = titleCs === "Jan Kočí" ? titleCs : `${titleCs} — Jan Kočí`;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jan Kočí",
  url: "https://jankoci.cz",
  jobTitle: "Systems Architect",
  email: "mailto:jan@jankoci.cz",
  sameAs: [
    "https://www.linkedin.com/in/jankoci",
    "https://github.com/horsedriver"
  ],
  subjectOf: {
    "@type": "SoftwareSourceCode",
    name: "CyberCore",
    codeRepository: "https://github.com/cyberDJs/CyberCore"
  },
  knowsAbout: ["Linux", "Infrastructure architecture", "VoIP", "Automation", "AI integration"]
};
---

<!doctype html>
<html lang="en" data-language="en" data-language-ready="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} data-content-en={description} data-content-cs={descriptionCs} />
    <meta name="theme-color" content="#090c0b" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jan Kočí" />
    <meta property="og:title" content={fullTitle} data-content-en={fullTitle} data-content-cs={fullTitleCs} />
    <meta property="og:description" content={description} data-content-en={description} data-content-cs={descriptionCs} />
    <meta property="og:locale" content="en_US" data-content-en="en_US" data-content-cs="cs_CZ" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jan Kočí — Systems Architect" data-content-en="Jan Kočí — Systems Architect" data-content-cs="Jan Kočí — systémový architekt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} data-content-en={fullTitle} data-content-cs={fullTitleCs} />
    <meta name="twitter:description" content={description} data-content-en={description} data-content-cs={descriptionCs} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="cs" href={alternateCs} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2212%22 fill=%22%23090c0b%22/><path d=%22M17 17h12v21c0 8-4 12-12 12v-9c2 0 3-1 3-4V26h-3zm17 0h10l-9 15 10 18H34l-8-17z%22 fill=%22%2300da00%22/></svg>" />
    <title data-title-en={fullTitle} data-title-cs={fullTitleCs}>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <style is:global>
      html:not([data-language="cs"]) [data-lang="cs"],
      html[data-language="cs"] [data-lang="en"] { display: none !important; }
      html:not([data-language="cs"]) .localized-block[data-lang="en"],
      html[data-language="cs"] .localized-block[data-lang="cs"] { display: block !important; }
      .case-body { grid-template-columns: minmax(0, .55fr) minmax(0, 1.45fr); }
      .case-body > *, .prose { min-width: 0; }
      .prose pre { max-width: 100%; overflow-x: auto; }
      @media (max-width: 820px) { .case-body { grid-template-columns: minmax(0, 1fr); } }
      @media (max-width: 360px) { .hero h1 { font-size: 2.85rem; } }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content"><span data-lang="en">Skip to content</span><span data-lang="cs">Přeskočit na obsah</span></a>
    <div class="site-shell">
      <SiteHeader />
      <main id="content">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="page-signal" aria-hidden="true">
      <span><span data-lang="en">{eyebrow}</span><span data-lang="cs">{eyebrowCs}</span></span>
    </div>
    <dialog class="cv-dialog" data-cv-dialog aria-labelledby="cv-dialog-title">
      <div class="cv-dialog-bar">
        <div>
          <p class="section-label">Curriculum vitae</p>
          <h2 id="cv-dialog-title"><span data-lang="en">Jan Kočí — Systems Architect</span><span data-lang="cs">Jan Kočí — systémový architekt</span></h2>
        </div>
        <button class="cv-close" type="button" data-cv-close aria-label="Close CV / Zavřít CV">×</button>
      </div>
      <iframe data-cv-frame title="Jan Kočí — interaktivní CV / interactive CV" loading="lazy"></iframe>
      <div class="cv-dialog-actions">
        <a class="button secondary" href="/cv/" target="_blank"><span data-lang="en">Open full version</span><span data-lang="cs">Otevřít plnou verzi</span></a>
      </div>
    </dialog>
    <script is:inline>
      (() => {
        const dialog = document.querySelector("[data-cv-dialog]");
        const frame = document.querySelector("[data-cv-frame]");
        if (dialog && typeof dialog.showModal === "function") {
          document.querySelectorAll("[data-cv-open]").forEach((link) => link.addEventListener("click", (event) => {
            event.preventDefault();
            if (!frame.src) frame.src = "/cv/";
            dialog.showModal();
            document.body.classList.add("dialog-open");
          }));
          document.querySelector("[data-cv-close]")?.addEventListener("click", () => dialog.close());
          dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
          dialog.addEventListener("close", () => document.body.classList.remove("dialog-open"));
        }
      })();
    </script>
  </body>
</html>
