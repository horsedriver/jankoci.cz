---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const {
  title,
  description,
  eyebrow = "Systems Architect · Infrastructure · Telephony · AI Integration"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "Jan Kočí" ? title : `${title} — Jan Kočí`;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jan Kočí",
  url: "https://jankoci.cz",
  jobTitle: "Systems Architect",
  email: "mailto:jan@jankoci.cz",
  sameAs: [
    "https://www.linkedin.com/in/jankoci",
    "https://github.com/cyberDJs/CyberCore"
  ],
  knowsAbout: ["Linux", "Infrastructure architecture", "VoIP", "Automation", "AI integration"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2212%22 fill=%22%23090c0b%22/><path d=%22M17 17h12v21c0 8-4 12-12 12v-9c2 0 3-1 3-4V26h-3zm17 0h10l-9 15 10 18H34l-8-17z%22 fill=%22%2300da00%22/></svg>" />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="content">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="page-signal" aria-hidden="true"><span>{eyebrow}</span></div>
  </body>
</html>
