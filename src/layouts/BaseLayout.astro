---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  titleCs?: string;
  description: string;
  descriptionCs?: string;
  eyebrow?: string;
  eyebrowCs?: string;
}

const {
  title,
  description,
  titleCs = title,
  descriptionCs = description,
  eyebrow = "Systems Architect · Infrastructure · Telephony · AI Integration",
  eyebrowCs = "Systémový architekt · Infrastruktura · Telefonie · Integrace AI"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "Jan Kočí" ? title : `${title} — Jan Kočí`;
const fullTitleCs = titleCs === "Jan Kočí" ? titleCs : `${titleCs} — Jan Kočí`;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jan Kočí",
  url: "https://jankoci.cz",
  jobTitle: "Systems Architect",
  email: "mailto:jan@jankoci.cz",
  sameAs: [
    "https://www.linkedin.com/in/jankoci",
    "https://github.com/cyberDJs/CyberCore"
  ],
  knowsAbout: ["Linux", "Infrastructure architecture", "VoIP", "Automation", "AI integration"]
};
---

<!doctype html>
<html lang="en" data-language-ready="false">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} data-content-en={description} data-content-cs={descriptionCs} />
    <meta name="theme-color" content="#090c0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} data-content-en={fullTitle} data-content-cs={fullTitleCs} />
    <meta property="og:description" content={description} data-content-en={description} data-content-cs={descriptionCs} />
    <meta property="og:locale" content="en_US" data-content-en="en_US" data-content-cs="cs_CZ" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="cs" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2212%22 fill=%22%23090c0b%22/><path d=%22M17 17h12v21c0 8-4 12-12 12v-9c2 0 3-1 3-4V26h-3zm17 0h10l-9 15 10 18H34l-8-17z%22 fill=%22%2300da00%22/></svg>" />
    <title data-title-en={fullTitle} data-title-cs={fullTitleCs}>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#content"><span data-lang="en">Skip to content</span><span data-lang="cs">Přeskočit na obsah</span></a>
    <div class="site-shell">
      <SiteHeader />
      <main id="content">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="page-signal" aria-hidden="true">
      <span><span data-lang="en">{eyebrow}</span><span data-lang="cs">{eyebrowCs}</span></span>
    </div>
    <dialog class="cv-dialog" data-cv-dialog aria-labelledby="cv-dialog-title">
      <div class="cv-dialog-bar">
        <div>
          <p class="section-label">Curriculum vitae</p>
          <h2 id="cv-dialog-title"><span data-lang="en">Jan Kočí — Systems Architect</span><span data-lang="cs">Jan Kočí — systémový architekt</span></h2>
        </div>
        <button class="cv-close" type="button" data-cv-close aria-label="Close CV / Zavřít CV">×</button>
      </div>
      <iframe data-cv-frame title="Jan Kočí — interaktivní CV / interactive CV" loading="lazy"></iframe>
      <div class="cv-dialog-actions">
        <a class="button secondary" href="/cv/" target="_blank"><span data-lang="en">Open full version</span><span data-lang="cs">Otevřít plnou verzi</span></a>
      </div>
    </dialog>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem("jk-language");
        const detected = navigator.language.toLowerCase().startsWith("cs") ? "cs" : "en";
        const setLanguage = (language, persist = true) => {
          const lang = language === "cs" ? "cs" : "en";
          root.lang = lang;
          root.dataset.language = lang;
          root.dataset.languageReady = "true";
          const title = document.querySelector("title[data-title-en]");
          if (title) document.title = title.dataset[lang === "cs" ? "titleCs" : "titleEn"];
          document.querySelectorAll("[data-content-en]").forEach((element) => {
            element.setAttribute("content", element.dataset[lang === "cs" ? "contentCs" : "contentEn"]);
          });
          document.querySelectorAll("[data-href-en]").forEach((element) => {
            element.setAttribute("href", element.dataset[lang === "cs" ? "hrefCs" : "hrefEn"]);
          });
          document.querySelectorAll("[data-aria-en]").forEach((element) => {
            element.setAttribute("aria-label", element.dataset[lang === "cs" ? "ariaCs" : "ariaEn"]);
          });
          document.querySelectorAll("[data-set-lang]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.setLang === lang));
          });
          if (persist) localStorage.setItem("jk-language", lang);
        };
        setLanguage(stored || detected, Boolean(stored));
        document.querySelectorAll("[data-set-lang]").forEach((button) => button.addEventListener("click", () => setLanguage(button.dataset.setLang)));
        const dialog = document.querySelector("[data-cv-dialog]");
        const frame = document.querySelector("[data-cv-frame]");
        document.querySelectorAll("[data-cv-open]").forEach((button) => button.addEventListener("click", () => {
          if (!frame.src) frame.src = "/cv/";
          dialog.showModal();
          document.body.classList.add("dialog-open");
        }));
        document.querySelector("[data-cv-close]")?.addEventListener("click", () => dialog.close());
        dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
        dialog?.addEventListener("close", () => document.body.classList.remove("dialog-open"));
      })();
    </script>
  </body>
</html>
